<!-- Shared log format, only ever loaded through <include>. -->
<included>
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- Constant fields, not MDC: they never vary per request (single tenant).
                 traceId/spanId come from the MDC, filled by Micrometer Tracing. -->
            <customFields>{"service":"${SERVICE_NAME:-unknown}","tenant":"default"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT_JSON"/>
    </root>
</included>
