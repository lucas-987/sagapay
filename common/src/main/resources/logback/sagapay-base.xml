<!-- Shared log format, only ever loaded through <include>. -->
<included>
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <!-- ISO 8601 in UTC, whatever the host zone. -->
            <timeZone>UTC</timeZone>
            <!-- Constant fields, not MDC: they never vary per request (single tenant), and the
                 service and version let a line be traced to a deployment.
                 traceId/spanId come from the MDC, filled by Micrometer Tracing. -->
            <customFields>{"service":"${SERVICE_NAME:-unknown}","version":"${SERVICE_VERSION:-unknown}","tenant":"default"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT_JSON"/>
    </root>
</included>
