# Copy to .env (never committed) and fill in a real value for the passwords.
#
# Spring's ${VAR:default} only applies the default when VAR is ABSENT, not when it's
# present but empty — so usernames below keep their real default value rather than
# being left blank. Passwords have no such default: an empty value would silently
# create a working account with an empty password — always fill in a real value.

# Restricted application account (ledger runtime).
LEDGER_APP_USERNAME=ledger_app
LEDGER_APP_PASSWORD=

# Restricted application account (transfer-orchestrator runtime).
ORCHESTRATOR_APP_USERNAME=orchestrator_app
ORCHESTRATOR_APP_PASSWORD=

# Code the sender submits to confirm a blocked transfer (transfer-orchestrator). Required: the
# service does not start without it, and the compose file sets no fallback. The value
# below is a local sample, replace it outside a local stack.
SAGAPAY_FRAUD_VERIFICATION_CODE=local-verification-code

# Optional timings of the fraud flow, in milliseconds (defaults shown): how long a blocked
# transfer waits for the sender, and how long the orchestrator waits for the fraud verdict.
# SAGA_CONFIRMATION_WINDOW_MS=120000
# SAGA_SCREENING_TIMEOUT_MS=10000

# Restricted application account (fraud-detection-service runtime).
FRAUD_APP_USERNAME=fraud_app
FRAUD_APP_PASSWORD=

# Schema-owner account (migrations).
SAGAPAY_DB_USERNAME=sagapay
SAGAPAY_DB_PASSWORD=
